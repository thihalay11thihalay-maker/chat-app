EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Realtime Database url, used for online presence only. Optional: without it the app runs fine and
# the chat list just shows no green dots. Take it from the Firebase console (Realtime Database >
# Database URL). It is a separate product from Firestore, so configuring the values above does not
# create it.
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.your-region.firebasedatabase.app

# Agora App ID, used by the phone and video call screen. Without it the call screen opens and says so
# rather than failing inside the SDK. Take it from the Agora console (Project Management > App ID).
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id

# The Agora App Certificate, which signs call tokens. SERVER ONLY. Do not prefix it with EXPO_PUBLIC_:
# anything so prefixed ships inside the app bundle, and a shipped certificate lets anybody mint a token
# for any channel on this project and listen in. It is the App *Certificate*, not the App ID above.
#
# With it, run `npm run call:tokens` and leave that running alongside the app. The call screen asks that
# process for a token each time a call opens.
AGORA_APP_CERTIFICATE=

# Where that token service is listening. Public on purpose -- it is an address, not a secret, and the
# app has to be able to reach it. On a phone this must be your computer's LAN address (the service prints
# the right one); localhost on the device means the device, not your machine.
EXPO_PUBLIC_AGORA_TOKEN_SERVER=http://192.168.1.10:8787

# The password for the test bot account the seed script creates. There is deliberately no default: a
# hardcoded one published the credential for a real account in the project. `npm run seed:bot` makes one up
# and prints it once when it creates the account; put that value here so `npm run bot:online` can sign in.
# Both scripts read this, so they cannot disagree about it.
BOT_EMAIL=chatbot@example.com
BOT_PASSWORD=

# The token service binds to 127.0.0.1 by default, so nothing but this machine can reach it. Set this to
# 0.0.0.0 only while testing on a physical device, which cannot use localhost: that puts a token minter on
# your network, so stop the process when you are done.
AGORA_TOKEN_SERVER_HOST=127.0.0.1

# Server-only. Never prefix with EXPO_PUBLIC_ or the token lands in the app bundle.
# Base64-encoded JSON of { apiKey, appId, regions } from the UploadThing dashboard.
UPLOADTHING_TOKEN=

# Absolute origin of the Expo server that hosts /api/uploadthing.
# In dev the Metro dev server host is used automatically when this is empty.
EXPO_PUBLIC_SERVER_ORIGIN=http://localhost:8081
