rules_version = '2';

// Firestore security rules for BeeTalk chat app.
//
// Data model:
//   users/{uid}                    - profile, geohash/latitude/longitude for nearby
//   rooms/{roomId}                 - participants[], kind, name, ownerId, lastMessage
//   rooms/{roomId}/messages/{msgId} - senderId, type, text/mediaUrl
//   friendRequests/{requestId}     - fromUid, toUid, status
//
// Deploy from a terminal with:  npm run deploy:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ helpers

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A room document belongs to the accounts listed in its participants.
    function inRoom(roomId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
    }

    // Who owns a room: the account that created it.
    function ownsRoom(room) {
      return 'ownerId' in room && room.ownerId == request.auth.uid;
    }

    // ------------------------------------------------------------------- users

    match /users/{uid} {
      // Any signed-in account may read a profile: the chat list shows the other
      // participant's name and avatar, and nearby friends reads geohash.
      allow get, list: if signedIn();

      // A profile is the account's own to write.
      allow create, update, delete: if owns(uid);
    }

    // ------------------------------------------------------------ friend requests

    match /friendRequests/{requestId} {
      // Both parties, and nothing else.
      allow get, list: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      // A request has to come from the account writing it, go to somebody else,
      // and arrive unanswered.
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';

      // Only the receiver may answer it.
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'createdAt'])
        && request.resource.data.status in ['accepted', 'rejected'];

      // Either side may remove it, but not once accepted.
      allow delete: if signedIn()
        && resource.data.status != 'accepted'
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // ------------------------------------------------------------------- rooms

    match /rooms/{roomId} {
      // A member may read their room.
      allow get: if inRoom(roomId);

      // Scoped to the caller's own conversations.
      allow list: if signedIn()
        && 'participants' in resource.data
        && request.auth.uid in resource.data.participants;

      // The creator must be one of the participants, and there must be at least two.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.ownerId == request.auth.uid
        && (!('kind' in request.resource.data)
          || request.resource.data.kind in ['direct', 'group'])
        && (!('name' in request.resource.data) || request.resource.data.name is string)
        && (!('about' in request.resource.data) || request.resource.data.about is string)
        && (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string);

      // Members may update the room's activity fields (last message preview).
      // The owner may update the room's description.
      allow update: if inRoom(roomId) && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTime', 'unreadCount'])
        || (ownsRoom(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'about', 'avatarUrl']))
      );

      // Deleting a room is the owner's call.
      allow delete: if inRoom(roomId)
        && (!('ownerId' in resource.data) || ownsRoom(resource.data));

      // Messages
      match /messages/{messageId} {
        allow get, list: if inRoom(roomId);

        // Only a member may post, and only as themselves.
        allow create: if inRoom(roomId)
          && request.resource.data.senderId == request.auth.uid;

        // The sender may edit their own message text.
        allow update: if inRoom(roomId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'createdAt']);

        // The sender may delete their own message.
        allow delete: if inRoom(roomId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ------------------------------------------------------------------ deny all

    match /{document=**} {
      allow read, write: if false;
    }
  }
}