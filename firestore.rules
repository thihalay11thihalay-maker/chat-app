rules_version = '2';

// Firestore security rules for the chat app.
//
// Data model used by the client:
//   users/{uid}                     - profile + geohash/latitude/longitude
//   users/{uid}/following/{userId}  - who this user follows
//   posts/{postId}                  - feed posts
//   posts/{postId}/reactions/{uid}  - { liked, loved } per reacting user
//   posts/{postId}/comments/{id}    - { userId, displayName, text, replyToName, parentId }
//   chats/{chatId}                  - participants[] (uids), lastMessage, ...
//   chats/{chatId}/messages/{msgId} - senderId, type, text/mediaUrl
//
// The reactions subcollection replaced the earlier users/{uid}/likes and /loves documents,
// which are no longer read or written. They can be deleted from Firestore once no client
// depends on them.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A chat document is visible/writable only to the users listed in participants.
    function isChatParticipant(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      // Any signed-in user may read a profile: the chat list shows the other
      // participant's name/avatar, and find-friends reads age/city/geohash.
      allow get, list: if isSignedIn();

      allow create: if isOwner(uid);

      // A user may edit only their own document.
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      // Following is a per-author marker. Without this match every read fell through to the
      // deny-all rule below.
      match /following/{followedId} {
        allow get, list: if isOwner(uid);
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // A comment or a reaction lives under a post, so reading one is really reading the post it
    // hangs off. Without this a private post's comments and reaction flags stay open to anyone who
    // knows the post id, which is a quieter version of the same leak the post rules just closed.
    function canReadPost(postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId)).data;

      return (!('visibility' in post) || post.visibility == 'public')
        || (
          isSignedIn()
          && (
            post.userId == request.auth.uid
            // The membership test is guarded rather than relying on the public branch above
            // short-circuiting past it: reading a field that is not there is a rule error, and a
            // rule that errors is a rule that denies.
            || ('visibleToUids' in post && request.auth.uid in post.visibleToUids)
          )
        );
    }

    // ---------------------------------------------------------------- posts
    //
    // Reading a post is governed by two fields written together at post time:
    //
    //   visibility      - public | followers_friends | friends_only | only_me
    //   visibleToUids   - the accounts allowed to read it, snapshotted from the author's follow
    //                     list when it was published
    //
    // The audience is denormalised onto the document on purpose. Firestore refuses any collection
    // query whose rule depends on the individual document, so a rule phrased as "readable if you
    // follow the author" can protect a `get` but can never let a feed query through at all. With
    // the audience in an array the check becomes an `in` on a field the query can filter on, which
    // Firestore can validate. See buildAudience() in src/lib/upload-post.ts for what the list is
    // and what the snapshot costs.
    //
    // The trade-off to keep in mind when changing this: `visibleToUids` is frozen at publish time,
    // so a new follower does not gain older restricted posts. Making that live needs a trusted
    // server maintaining the list.
    match /posts/{postId} {
      // A post with no visibility field predates this feature and is treated as public, which is
      // what it was. Same for an audience that is missing on an older restricted post.
      function hasVisibility() {
        return 'visibility' in resource.data;
      }

      function isPublic() {
        return !hasVisibility() || resource.data.visibility == 'public';
      }

      function isAuthor() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      function isInAudience() {
        return isSignedIn()
          && 'visibleToUids' in resource.data
          && request.auth.uid in resource.data.visibleToUids;
      }

      // Readable when public, always your own, or explicitly in the audience. Written as three
      // separate disjuncts rather than one combined condition because the feed validates each of
      // its queries against this: a `visibility == 'public'` query must be provable from the first
      // clause alone, and collapsing them together would make every clause unprovable.
      allow get, list: if isPublic() || isAuthor() || isInAudience();

      // A caller cannot invent an audience, and cannot write a visibility the app does not know.
      // Checked on the value being written rather than the stored one.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          !('visibility' in request.resource.data)
          || request.resource.data.visibility in ['public', 'followers_friends', 'friends_only', 'only_me']
        )
        && (
          !('visibleToUids' in request.resource.data)
          || request.resource.data.visibleToUids is list
        );

      // Update is no longer open to any signed-in user. It used to be, because the share counter
      // is written on every post including other people's, but that left anyone able to rewrite
      // `userId` and `visibility` on a post they do not own, which would have made the read rules
      // above decorative. So an update is either the author's, or a counter-only write from anyone
      // whose changed fields are all counters.
      allow update: if isAuthor()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['shareCount', 'sharesCount', 'likesCount', 'lovesCount', 'commentsCount'])
        );

      // Deleting is the author's alone, so the rule enforces what the feed's options menu
      // already hides behind the owner check. Requires a redeploy of these rules.
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // One document per reacting user, holding both the liked and loved flags. The feed
      // counts these documents with a collection listener instead of keeping a counter on
      // the post, so the numbers can never drift from the reactions themselves.
      //
      // list is deliberately not scoped to the owner, but it is scoped to the post being readable:
      // Firestore denies a collection query unless the rule allows it for every document, so
      // counting reactions has to be possible for anyone who can see the post. Read access is
      // therefore no wider than the post's own audience, which is the same information the
      // published count already implies.
      match /reactions/{userId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && canReadPost(postId);
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Comments are read by everyone who can read the post, and written as their own author, the
      // same split the reactions subcollection uses. A comment document is immutable once written,
      // so a reply cannot be made to impersonate somebody else.
      match /comments/{commentId} {
        allow get, list: if isSignedIn() && canReadPost(postId);

        allow create: if isSignedIn()
          && canReadPost(postId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update: if false;

        // The author can take a comment back down. Replies go with the comment they hang
        // under, so the second case lets the author of a comment also remove the replies
        // underneath it, which are documents other people wrote. Without it a thread with
        // replies could not be deleted at all: the replies would be denied and the whole
        // transaction would fail. A reply is still only removable through its parent, never
        // by anyone else.
        allow delete: if isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || (
              resource.data.parentId is string
              && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(resource.data.parentId))
              && get(/databases/$(database)/documents/posts/$(postId)/comments/$(resource.data.parentId)).data.userId == request.auth.uid
            )
          );
      }
    }

    // ---------------------------------------------------------------- chats
    match /chats/{chatId} {
      allow get: if isChatParticipant(chatId);
      allow list: if isSignedIn();

      // The caller must be one of the two participants. The participant list is
      // sorted before it is written, so the creator is not necessarily [0].
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      // Participant list is immutable, so nobody can add themselves to a chat later.
      allow update: if isChatParticipant(chatId)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if isChatParticipant(chatId);

      // ------------------------------------------------------------ messages
      match /messages/{messageId} {
        allow get, list: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid;

        // A sender may fix or retract their own message; nobody edits someone else's.
        allow update, delete: if isChatParticipant(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
