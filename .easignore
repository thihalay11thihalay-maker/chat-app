# Files here are excluded from `eas build` and `eas update` uploads.
# Anything listed would be uploaded to Expo's build servers and shipped in the
# source archive, so keep credentials and machine-local files out.

.env
.env.*
!.env.example

# Firebase service account and key material
*-firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# Signing material and native projects generated by CNG
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
ios/
android/

# Logs and build output
*.log
dist/
web-build/
.expo/
node_modules/
