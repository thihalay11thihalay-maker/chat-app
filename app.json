{
  "expo": {
    "name": "BeeTalk",
    "slug": "beetalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beetalk",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow BeeTalk to record voice messages.",
        "NSPhotoLibraryUsageDescription": "Allow BeeTalk to use your photos for profile and stickers.",
        "NSLocationWhenInUseUsageDescription": "Allow BeeTalk to find friends nearby."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0088CC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.beetalk.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0088CC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow BeeTalk to record and send voice messages.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow BeeTalk to use your photos for profile.",
          "savePhotosPermission": "Allow BeeTalk to save photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c002a89-f0aa-4330-921a-dbc975e03b3b"
      }
    }
  }
}